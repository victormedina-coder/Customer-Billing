# Facturama
FACTURAMA_USER=
FACTURAMA_PASS=
FACTURAMA_ENV=

# ──────────────────────────────────────────────────
# Shopify — credenciales por marca (server-only)
# ──────────────────────────────────────────────────

# Versión del Admin API de Shopify (default: 2025-07)
SHOPIFY_API_VERSION=

# Ariat — token estático (shpat_…)
ARIAT_SHOPIFY_STORE=        # ej. ariat-mx.myshopify.com
ARIAT_SHOPIFY_ACCESS_TOKEN= # shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stetson — OAuth client_credentials
STETSON_SHOPIFY_STORE=          # ej. stetson-mx.myshopify.com
STETSON_SHOPIFY_CLIENT_ID=
STETSON_SHOPIFY_CLIENT_SECRET=

# Western Brothers — OAuth client_credentials
WB_SHOPIFY_STORE=               # ej. westernbrothers-mx.myshopify.com
WB_SHOPIFY_CLIENT_ID=
WB_SHOPIFY_CLIENT_SECRET=

# ──────────────────────────────────────────────────
# Lookup mock (desarrollo sin credenciales Shopify)
# Establecer a 'true' para usar DEMO_TICKETS en lugar de llamar a Shopify.
# En producción debe ser 'false' o no definida.
# ──────────────────────────────────────────────────
NEXT_PUBLIC_LOOKUP_MOCK=

# Base de datos
DATABASE_URL=
DATABASE_URL_TEST=

# Fuente de órdenes ('shopify' | 'netsuite')
ORDER_SOURCE=shopify

# Rate limiting (Redis en Railway). Si REDIS_URL no está, el rate limiting es no-op.
REDIS_URL=
# Nº de proxies de confianza frente a la app (Railway = 1). Define de qué hop
# de X-Forwarded-For se toma la IP del cliente para el rate limiting.
TRUSTED_PROXY_COUNT=1
# Overrides opcionales por endpoint (si se omiten, se usan los defaults del código):
# RATE_LIMIT_LOOKUP_MAX=        RATE_LIMIT_LOOKUP_WINDOW_SEC=
# RATE_LIMIT_EMIT_MAX=          RATE_LIMIT_EMIT_WINDOW_SEC=
# RATE_LIMIT_FISCAL_MAX=        RATE_LIMIT_FISCAL_WINDOW_SEC=
# RATE_LIMIT_RESEND_MAX=        RATE_LIMIT_RESEND_WINDOW_SEC=
# RATE_LIMIT_DOWNLOAD_MAX=      RATE_LIMIT_DOWNLOAD_WINDOW_SEC=
