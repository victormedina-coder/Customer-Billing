# Facturama
FACTURAMA_USER=
FACTURAMA_PASS=
FACTURAMA_ENV=
# Identificador del emisor/CSD en Facturama
FACTURAMA_NAME_ID=
# Series fiscales por marca para el CFDI global (opcionales; default en código:
# GDL1 / STET / WB). Úsalas solo si el ambiente tiene series distintas dadas de alta.
ARIAT_FACTURAMA_SERIE=
STETSON_FACTURAMA_SERIE=
WB_FACTURAMA_SERIE=
# ClaveProdServ por defecto (SAT) — SOLO aplica al CFDI INDIVIDUAL.
# Default en código si se deja vacío: '53102500'. El CFDI GLOBAL usa
# '01010101' fijo en código (normativo, regla SAT 2.7.1.21) y NO lee esta var.
FACTURAMA_DEFAULT_PRODUCT_CODE=
# ClaveUnidad por defecto (SAT) — SOLO aplica al CFDI INDIVIDUAL.
# Default en código si se deja vacío: 'H87' (Pieza). El CFDI GLOBAL usa
# 'ACT' fijo en código (normativo, regla SAT 2.7.1.21) y NO lee esta var.
FACTURAMA_DEFAULT_UNIT_CODE=
# FormaPago por defecto (SAT)
FACTURAMA_DEFAULT_PAYMENT_FORM=
# Override manual OPCIONAL del Lugar de Expedición (código postal).
# Por defecto (dejar vacío) se resuelve dinámicamente en cada timbrado
# desde el perfil fiscal del emisor en Facturama (GET /TaxEntity →
# IssuedIn.ZipCode), con cache de 1h. Solo definir esta var si se necesita
# forzar un lugar de expedición distinto al registrado en Facturama
# (p. ej. escenario multi-sucursal). NUNCA se usa el CP del receptor.
FACTURAMA_EXPEDITION_PLACE=
# Correo remitente del CFDI (opcional; el reenvío funciona sin ella)
FACTURAMA_ISSUER_EMAIL=
# 'true' genera un CFDI de prueba en emit sin llamar a Facturama ni Shopify (desarrollo)
EMIT_MOCK=
# Minutos de antigüedad tras los cuales una fila 'pending' huérfana (proceso
# murió entre el insert-first y el timbrado/rollback) se libera de forma lazy
# en el siguiente intento de emit sobre el mismo pedido. Default: 10 (mucho
# mayor que cualquier timbrado real, que tarda segundos). Ver
# docs/08-plan-pre-deploy.md §4.
PENDING_TTL_MINUTES=

# ──────────────────────────────────────────────────
# Shopify — credenciales por marca (server-only)
# ──────────────────────────────────────────────────

# Versión del Admin API de Shopify (default: 2025-07)
SHOPIFY_API_VERSION=

# Ariat — token estático (shpat_…)
ARIAT_SHOPIFY_STORE=        # ej. ariat-mx.myshopify.com
ARIAT_SHOPIFY_ACCESS_TOKEN= # shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stetson — OAuth client_credentials
STETSON_SHOPIFY_STORE=          # ej. stetson-mx.myshopify.com
STETSON_SHOPIFY_CLIENT_ID=
STETSON_SHOPIFY_CLIENT_SECRET=

# Western Brothers — OAuth client_credentials
WB_SHOPIFY_STORE=               # ej. westernbrothers-mx.myshopify.com
WB_SHOPIFY_CLIENT_ID=
WB_SHOPIFY_CLIENT_SECRET=

# ──────────────────────────────────────────────────
# Lookup mock (desarrollo sin credenciales Shopify)
# Establecer a 'true' para usar DEMO_TICKETS en lugar de llamar a Shopify.
# En producción debe ser 'false' o no definida.
# ──────────────────────────────────────────────────
NEXT_PUBLIC_LOOKUP_MOCK=

# Base de datos
DATABASE_URL=
DATABASE_URL_TEST=

# Rate limiting (Redis en Railway). Si REDIS_URL no está, el rate limiting es no-op.
REDIS_URL=
# Nº de proxies de confianza frente a la app (Railway = 1). Define de qué hop
# de X-Forwarded-For se toma la IP del cliente para el rate limiting.
TRUSTED_PROXY_COUNT=1
# Overrides opcionales por endpoint (si se omiten, se usan los defaults del código):
# RATE_LIMIT_LOOKUP_MAX=        RATE_LIMIT_LOOKUP_WINDOW_SEC=
# RATE_LIMIT_EMIT_MAX=          RATE_LIMIT_EMIT_WINDOW_SEC=
# RATE_LIMIT_FISCAL_MAX=        RATE_LIMIT_FISCAL_WINDOW_SEC=
# RATE_LIMIT_RESEND_MAX=        RATE_LIMIT_RESEND_WINDOW_SEC=
# RATE_LIMIT_DOWNLOAD_MAX=      RATE_LIMIT_DOWNLOAD_WINDOW_SEC=
# RATE_LIMIT_VALIDATE_MAX=      RATE_LIMIT_VALIDATE_WINDOW_SEC=  (lookup por folio, default 5 / 900s)

# Modo de la ventana de facturación (default en código: 'current-month')
INVOICE_WINDOW_MODE=
# Hora (0-23, zona MX) del corte de facturación del último día del mes en
# curso — pasado este corte, la ventana individual se cierra aunque el mes
# no haya terminado (evita doble factura con la global que ya barrió el
# periodo). Default en código: 21 (decisión de contabilidad 2026-07-16).
INVOICE_WINDOW_CUTOFF_HOUR=
# Correo de facturación que se muestra en la pantalla de bloqueo del portal
# cuando la ventana del mes cerró (R3). Definido por el usuario — NO es un
# placeholder.
BILLING_CONTACT_EMAIL=facturacion@1522.mx

# ──────────────────────────────────────────────────
# Facturación Global (mensual y diaria) — POST /api/global/emit
# ──────────────────────────────────────────────────

# Secreto compartido que debe enviar el llamador (cron/job interno) en el
# header 'x-global-secret'. Sin esta variable el endpoint responde 503
# (feature deshabilitada) — NUNCA correr en producción sin definirla.
GLOBAL_INVOICE_SECRET=
# Tope de conceptos (líneas) por CFDI global — entero >= 1. Default: 250.
GLOBAL_MAX_ITEMS_PER_CFDI=
# Overrides opcionales del rate limit de /api/global/emit (default: 5 / 900s):
# RATE_LIMIT_GLOBAL_EMIT_MAX=   RATE_LIMIT_GLOBAL_EMIT_WINDOW_SEC=
#constante de IVA para la facturación global, default: 0.16
GLOBAL_TAX_RATE=
# Fecha ISO para simular el instante "ahora" al resolver periodos `relative`
# (ver docs/11-cron-facturacion-global.md) o la ventana de facturación.
# Ignorada por completo cuando NODE_ENV=production (guard duro en
# getEvaluationNow) — NUNCA definir esta variable en el .env de producción.
DEV_NOW_OVERRIDE=
# ──────────────────────────────────────────────────
# SMTP para envío de reportes globales (opcional; si no se define, no se envían correos)
SMTP_HOST=
# Puerto SMTP (default: 587)
SMTP_PORT=
# Usuario y contraseña SMTP (ej. cuenta de Gmail con App Password)
SMTP_USER=
SMTP_PASS=
# Correo remitente de los reportes globales (opcional; si no se define, se usa SMTP_USER)
GLOBAL_REPORT_FROM=
# Correo de destino de los reportes globales (opcional; si no se define, se usa SMTP_USER)
GLOBAL_REPORT_TO=